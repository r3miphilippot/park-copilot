# Copy to .env and fill in. Never commit .env.

# --- MongoDB Atlas (free M0 cluster) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=park_copilot

# --- LLM ---
# Free key: https://console.groq.com (API Keys)
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Fallback on 429 / timeout / 5xx. Groq quotas are per model, so another Groq model works
# on Hugging Face. Locally you can use Ollama instead: FALLBACK_PROVIDER=ollama, FALLBACK_MODEL=qwen3
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
