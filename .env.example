# Copy to .env and fill in. Never commit .env.

# --- MongoDB Atlas (free M0 cluster) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=park_copilot

# --- LLM ---
# Free key: https://console.groq.com (API Keys)
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Fallback on 429 / timeout / 5xx. Groq quotas are per model, so another Groq model works
# on Hugging Face. Locally you can use Ollama instead: FALLBACK_PROVIDER=ollama, FALLBACK_MODEL=qwen3
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434

# --- API ---
# Comma-separated list of front-end origins allowed to call /chat
ALLOWED_ORIGINS=https://remiphilippot.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:7860
RATE_LIMIT_PER_MINUTE=10
DAILY_REQUEST_CAP=200

# --- Observability (optional) ---
# Free account: https://cloud.langfuse.com. Leave empty to disable Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
